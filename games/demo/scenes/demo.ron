// Rust4D Wave 5 — Lua Demo Game scene.
//
// A curated gallery: a floor, six 4D primitives arranged in a ring around the
// origin, and a small "trigger zone" hypersphere at the center. Lua scripts
// (see games/demo/main.lua) rotate each gallery primitive in a W-involving
// plane so the 3D slice morphs over time, detect when the player walks into the
// central zone, and drive a HUD + audio cue + scale pulse on trigger.
//
// Load with:
//   R4D_SCENE__PATH=games/demo/scenes/demo.ron cargo run -- --game games/demo
Scene(
    name: "Lua Demo Gallery",
    entities: [
        // --- Floor ---
        EntityTemplate(
            name: Some("floor"),
            tags: ["static"],
            transform: Transform4D(
                position: Vec4(x: 0.0, y: -2.0, z: 0.0, w: 0.0),
                rotation: (s: 1.0, b_xy: 0.0, b_xz: 0.0, b_xw: 0.0, b_yz: 0.0, b_yw: 0.0, b_zw: 0.0, p: 0.0),
                scale: 1.0,
            ),
            shape: ShapeTemplate(
                type: "Hyperplane",
                y: -2.0,
                size: 24.0,
                subdivisions: 24,
                cell_size: 8.0,
                thickness: 0.001,
            ),
            material: Material(base_color: (0.36, 0.36, 0.40, 1.0)),
        ),

        // --- Gallery ring (6 primitives, radius 6 in the XZ plane) ---
        // Each is tagged ["gallery", "<name>"] so world.query("tags") and
        // world.find_by_name both locate them. Lua rotates each in a distinct
        // W-involving plane so the 3D slice morphs as it spins.

        EntityTemplate(
            name: Some("tesseract"),
            tags: ["static", "gallery"],
            transform: Transform4D(
                position: Vec4(x: 6.0, y: 0.0, z: 0.0, w: 0.0),
                rotation: (s: 1.0, b_xy: 0.0, b_xz: 0.0, b_xw: 0.0, b_yz: 0.0, b_yw: 0.0, b_zw: 0.0, p: 0.0),
                scale: 1.0,
            ),
            shape: ShapeTemplate(type: "Tesseract", size: 2.0),
            material: Material(base_color: (1.0, 0.82, 0.32, 1.0)),
        ),
        EntityTemplate(
            name: Some("pentachoron"),
            tags: ["static", "gallery"],
            transform: Transform4D(
                position: Vec4(x: 3.0, y: 0.0, z: 5.196, w: 0.0),
                rotation: (s: 1.0, b_xy: 0.0, b_xz: 0.0, b_xw: 0.0, b_yz: 0.0, b_yw: 0.0, b_zw: 0.0, p: 0.0),
                scale: 1.2,
            ),
            shape: ShapeTemplate(type: "Pentachoron", circumradius: 1.3),
            material: Material(base_color: (1.0, 0.38, 0.34, 1.0)),
        ),
        EntityTemplate(
            name: Some("hexadecachoron"),
            tags: ["static", "gallery"],
            transform: Transform4D(
                position: Vec4(x: -3.0, y: 0.0, z: 5.196, w: 0.0),
                rotation: (s: 1.0, b_xy: 0.0, b_xz: 0.0, b_xw: 0.0, b_yz: 0.0, b_yw: 0.0, b_zw: 0.0, p: 0.0),
                scale: 1.2,
            ),
            shape: ShapeTemplate(type: "Hexadecachoron", circumradius: 1.35),
            material: Material(base_color: (0.55, 1.0, 0.48, 1.0)),
        ),
        EntityTemplate(
            name: Some("icositetrachoron"),
            tags: ["static", "gallery"],
            transform: Transform4D(
                position: Vec4(x: -6.0, y: 0.0, z: 0.0, w: 0.0),
                rotation: (s: 1.0, b_xy: 0.0, b_xz: 0.0, b_xw: 0.0, b_yz: 0.0, b_yw: 0.0, b_zw: 0.0, p: 0.0),
                scale: 1.1,
            ),
            shape: ShapeTemplate(type: "Icositetrachoron", circumradius: 1.5),
            material: Material(base_color: (0.72, 0.45, 1.0, 1.0)),
        ),
        EntityTemplate(
            name: Some("spherinder"),
            tags: ["static", "gallery"],
            transform: Transform4D(
                position: Vec4(x: -3.0, y: 0.0, z: -5.196, w: 0.0),
                rotation: (s: 1.0, b_xy: 0.0, b_xz: 0.0, b_xw: 0.0, b_yz: 0.0, b_yw: 0.0, b_zw: 0.0, p: 0.0),
                scale: 1.0,
            ),
            shape: ShapeTemplate(type: "Spherinder", radius: 1.05, half_height: 1.25, subdivisions: 2),
            material: Material(base_color: (0.28, 0.95, 0.88, 1.0)),
        ),
        EntityTemplate(
            name: Some("duocylinder"),
            tags: ["static", "gallery"],
            transform: Transform4D(
                position: Vec4(x: 3.0, y: 0.0, z: -5.196, w: 0.0),
                rotation: (s: 1.0, b_xy: 0.0, b_xz: 0.0, b_xw: 0.0, b_yz: 0.0, b_yw: 0.0, b_zw: 0.0, p: 0.0),
                scale: 1.0,
            ),
            shape: ShapeTemplate(type: "Duocylinder", radius_xy: 1.0, radius_zw: 1.0, segments: 32),
            material: Material(base_color: (0.40, 0.65, 1.0, 1.0)),
        ),

        // --- Trigger zone (small hypersphere at the ring center) ---
        // Lua detects the player entering a 4D AABB around this point and
        // fires an audio cue + HUD flash + scale pulse. Semi-transparent so the
        // gallery ring is still visible through it.
        EntityTemplate(
            name: Some("trigger_zone"),
            tags: ["static", "trigger"],
            transform: Transform4D(
                position: Vec4(x: 0.0, y: 0.0, z: 0.0, w: 0.0),
                rotation: (s: 1.0, b_xy: 0.0, b_xz: 0.0, b_xw: 0.0, b_yz: 0.0, b_yw: 0.0, b_zw: 0.0, p: 0.0),
                scale: 1.0,
            ),
            shape: ShapeTemplate(type: "Hypersphere", radius: 0.6, subdivisions: 2),
            material: Material(base_color: (0.30, 1.0, 0.85, 0.55)),
        ),
    ],
    gravity: Some(-20.0),
    player_spawn: Some((0.0, 1.5, 14.0, 0.0)),
)